# Add this after RapidAPI creates the API project and gives you its proxy secret.
RAPIDAPI_PROXY_SECRET=replace-with-the-value-from-rapidapi

# Your deployed HTTPS base URL. It is included in the generated OpenAPI document.
PUBLIC_BASE_URL=https://api.example.com

# Product limits. Raise these only after measuring memory and latency.
MAX_TEXT_LENGTH=20000
MAX_BODY_BYTES=1000000
